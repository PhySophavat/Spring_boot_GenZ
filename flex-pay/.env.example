# ─── Database ───────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/flex-pays
DB_USERNAME=postgres
DB_PASSWORD=your_strong_password_here

# ─── JWT ────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=flex-pay-api

# ─── File Upload ────────────────────────────────────────────────────
# Absolute path to store uploaded chat attachments
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_BYTES=10485760

# ─── Server ─────────────────────────────────────────────────────────
SERVER_PORT=8082

# ─── Frontend ───────────────────────────────────────────────────────
# In production: set CORS_ALLOWED_ORIGIN to your frontend domain
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ─── Notes ──────────────────────────────────────────────────────────
# Never commit real .env values to version control.
# Use HTTPS (TLS) and WSS in production for transport-layer security.
# Passwords must be hashed with bcrypt or Argon2id — never store plaintext.
# This project uses bcrypt via Spring Security Crypto.
