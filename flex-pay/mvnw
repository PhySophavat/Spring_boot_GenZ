#!/bin/sh
BASEDIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
MAVEN_HOME="$BASEDIR/.mvn/apache-maven-3.9.9"
MAVEN_BIN="$MAVEN_HOME/bin/mvn"
MAVEN_VERSION="3.9.9"
DOWNLOAD_URL="https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz"
DOWNLOAD_DIR="$BASEDIR/.mvn/downloads"
ARCHIVE_FILE="$DOWNLOAD_DIR/apache-maven-$MAVEN_VERSION-bin.tar.gz"

if [ ! -x "$MAVEN_BIN" ]; then
  echo "Maven $MAVEN_VERSION not found locally. Downloading..."
  mkdir -p "$DOWNLOAD_DIR"
  curl -fsSL "$DOWNLOAD_URL" -o "$ARCHIVE_FILE" || exit 1
  tar -xzf "$ARCHIVE_FILE" -C "$BASEDIR/.mvn" || exit 1
fi

if [ ! -x "$MAVEN_BIN" ]; then
  echo "Failed to prepare Maven at $MAVEN_BIN"
  exit 1
fi

exec "$MAVEN_BIN" "$@"
